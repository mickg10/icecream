{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icecream-distribution-scenario",
  "title": "Icecream codec distribution scenario v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "seed",
    "environments",
    "workers",
    "network",
    "scheduler",
    "experiment"
  ],
  "properties": {
    "schema": {
      "enum": [
        "icecream-distribution-scenario-v1",
        "icecream-distribution-scenario-v2"
      ]
    },
    "name": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_count",
        "egress_count",
        "producer_to_authority",
        "producer_to_egress"
      ],
      "properties": {
        "authority_count": { "type": "integer", "minimum": 1 },
        "egress_count": { "type": "integer", "minimum": 1 },
        "producer_to_authority": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "producer_to_egress": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env_count", "job_selection"],
      "properties": {
        "env_count": { "type": "integer", "minimum": 1 },
        "job_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "jobs"],
          "properties": {
            "mode": { "enum": ["explicit", "catalog-order", "seeded-permutation", "trace"] },
            "jobs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "environment",
                  "trace",
                  "corpus_root",
                  "builds",
                  "start_ns",
                  "build_release",
                  "tu_release"
                ],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "environment": { "type": "integer", "minimum": 0 },
                  "trace": { "type": "string", "minLength": 1 },
                  "corpus_root": { "type": "string", "minLength": 1 },
                  "builds": { "type": "integer", "minimum": 1 },
                  "start_ns": { "type": "integer", "minimum": 0 },
                  "build_release": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["mode"],
                    "properties": {
                      "mode": { "enum": ["after-previous", "concurrent", "fixed-interval"] },
                      "interval_ns": { "type": "integer", "minimum": 0 },
                      "gap_ns": { "type": "integer", "minimum": 0 }
                    },
                    "allOf": [
                      {
                        "if": { "properties": { "mode": { "const": "fixed-interval" } } },
                        "then": { "required": ["interval_ns"] }
                      },
                      {
                        "if": { "properties": { "mode": { "const": "fixed-interval" } } },
                        "then": { "not": { "required": ["gap_ns"] } }
                      },
                      {
                        "if": { "properties": { "mode": { "const": "after-previous" } } },
                        "then": { "not": { "required": ["interval_ns"] } }
                      },
                      {
                        "if": { "properties": { "mode": { "const": "concurrent" } } },
                        "then": {
                          "not": {
                            "anyOf": [
                              { "required": ["interval_ns"] },
                              { "required": ["gap_ns"] }
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "tu_release": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["mode"],
                    "properties": {
                      "mode": { "enum": ["all-at-zero", "trace"] },
                      "trace": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["f_count", "template"],
      "properties": {
        "f_count": { "type": "integer", "minimum": 1 },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slots", "compile_profile", "initial_cache"],
          "properties": {
            "slots": { "type": "integer", "minimum": 1 },
            "input_staging_slots": { "type": "integer", "minimum": 1 },
            "compile_profile": { "type": "string", "minLength": 1 },
            "initial_cache": { "enum": ["cold", "retained"] }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c_to_f", "f_to_c"],
      "properties": {
        "c_to_f": { "$ref": "#/$defs/link" },
        "f_to_c": { "$ref": "#/$defs/link" },
        "shared_fabric_bps": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [
        { "required": ["shared_fabric_bps"] },
        {
          "properties": {
            "c_to_f": { "required": ["fabric_bits_per_second"] },
            "f_to_c": { "required": ["fabric_bits_per_second"] }
          }
        }
      ]
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready_job_policy", "placement_policy"],
      "properties": {
        "ready_job_policy": {
          "enum": ["fifo-release", "environment-round-robin", "shortest-known", "trace"]
        },
        "placement_policy": {
          "enum": [
            "round-robin",
            "fastest",
            "resident",
            "home",
            "rendezvous",
            "r4-state",
            "r5-bounded",
            "trace"
          ]
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codecs", "routing_mode"],
      "properties": {
        "codecs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["grz", "p29"] }
        },
        "routing_mode": { "enum": ["online", "replay"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": { "const": "icecream-distribution-scenario-v2" }
        }
      },
      "then": { "required": ["topology"] },
      "else": { "not": { "required": ["topology"] } }
    }
  ],
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bits_per_second", "one_way_latency_ns", "lanes_per_endpoint"],
      "properties": {
        "bits_per_second": { "type": "integer", "minimum": 1 },
        "per_environment_bits_per_second": { "type": "integer", "minimum": 1 },
        "per_producer_bits_per_second": { "type": "integer", "minimum": 1 },
        "per_authority_bits_per_second": { "type": "integer", "minimum": 1 },
        "per_egress_bits_per_second": { "type": "integer", "minimum": 1 },
        "per_worker_bits_per_second": { "type": "integer", "minimum": 1 },
        "fabric_bits_per_second": { "type": "integer", "minimum": 1 },
        "writer_quantum_bytes": { "type": "integer", "minimum": 1 },
        "max_priority_burst_quanta": { "type": "integer", "minimum": 1 },
        "one_way_latency_ns": { "type": "integer", "minimum": 0 },
        "lanes_per_endpoint": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
