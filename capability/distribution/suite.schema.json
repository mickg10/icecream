{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icecream-distribution-suite-v1",
  "title": "Icecream distribution scenario suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "scenarios", "diagnostic_codecs"],
  "properties": {
    "schema": { "const": "icecream-distribution-suite-v1" },
    "name": { "type": "string", "minLength": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "diagnostic_codecs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["compile-only", "raw"] }
    }
  }
}
