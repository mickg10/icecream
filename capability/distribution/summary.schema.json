{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icecream-experiment-result-v2",
  "title": "Icecream canonical experiment result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "scenario", "scenario_sha256", "scenario_digest",
    "workload_inputs", "codec_adapter", "physical_codec_result",
    "codec_metadata", "dialogue_window_per_route", "relationship_ordering",
    "routing", "placement_policy", "ready_job_policy", "jobs", "environments",
    "build_epochs", "cold_builds", "warm_builds", "workers", "slots_per_worker",
    "input_staging_slots_per_worker", "compiler_slot_assignment",
    "total_worker_slots", "raw_bytes", "c_to_f_bytes", "f_to_c_bytes",
    "environment_c_to_f_bytes", "network_c_to_f_bytes", "network_f_to_c_bytes",
    "scored_outgoing_bytes", "source_transfer_score_excludes_environment",
    "tu_availability", "preprocessing_in_score", "environment",
    "exact_byte_ledger", "replay_closure", "makespan_ns", "makespan_seconds",
    "summed_generation_ns", "summed_generation_seconds",
    "summed_capacity_floor_ns", "summed_capacity_floor_seconds",
    "summed_generation_over_capacity_floor", "capacity_floor_efficiency",
    "wall_minus_summed_generation_ns", "compiler_work_ns",
    "timeline_snapshot_interval_ns", "timeline_active_ns", "timeline_records",
    "timeline_snapshots", "timeline_gaps", "timeline_state_coverage",
    "selected_main_protocol", "selected_cache_wire", "selected_codec_profile",
    "compile_result"
  ],
  "properties": {
    "schema": {"const": "icecream-experiment-result-v2"},
    "scenario": {"type": "string", "minLength": 1},
    "scenario_sha256": {"$ref": "#/$defs/sha256"},
    "scenario_digest": {"$ref": "#/$defs/sha256"},
    "workload_inputs": {"type": "object", "minProperties": 1},
    "codec_adapter": {"type": "string", "minLength": 1},
    "physical_codec_result": {"type": "boolean"},
    "codec_metadata": {"type": "object"},
    "dialogue_window_per_route": {"type": ["integer", "null"], "minimum": 1},
    "relationship_ordering": {"const": "TU_SEQ is allocated in prepared-input release order per C; REL_SEQ is allocated independently in route-local dispatch order"},
    "routing": {"type": "object"},
    "placement_policy": {"type": "string", "minLength": 1},
    "ready_job_policy": {"type": "string", "minLength": 1},
    "jobs": {"$ref": "#/$defs/nonnegative"},
    "environments": {"$ref": "#/$defs/positive"},
    "build_epochs": {"$ref": "#/$defs/positive"},
    "cold_builds": {"$ref": "#/$defs/nonnegative"},
    "warm_builds": {"$ref": "#/$defs/nonnegative"},
    "workers": {"$ref": "#/$defs/positive"},
    "slots_per_worker": {"$ref": "#/$defs/positive"},
    "input_staging_slots_per_worker": {"$ref": "#/$defs/positive"},
    "compiler_slot_assignment": {"enum": ["at input readiness", "reserved with scheduler assignment"]},
    "total_worker_slots": {"$ref": "#/$defs/positive"},
    "raw_bytes": {"$ref": "#/$defs/nonnegative"},
    "c_to_f_bytes": {"$ref": "#/$defs/nonnegative"},
    "f_to_c_bytes": {"$ref": "#/$defs/nonnegative"},
    "environment_c_to_f_bytes": {"$ref": "#/$defs/nonnegative"},
    "network_c_to_f_bytes": {"$ref": "#/$defs/nonnegative"},
    "network_f_to_c_bytes": {"$ref": "#/$defs/nonnegative"},
    "scored_outgoing_bytes": {"$ref": "#/$defs/nonnegative"},
    "source_transfer_score_excludes_environment": {"const": true},
    "tu_availability": {"const": "all-at-zero-at-each-build-release"},
    "preprocessing_in_score": {"const": false},
    "environment": {"type": "object"},
    "exact_byte_ledger": {"type": "object"},
    "replay_closure": {"type": "object"},
    "makespan_ns": {"$ref": "#/$defs/nonnegative"},
    "makespan_seconds": {"type": "number", "minimum": 0},
    "summed_generation_ns": {"$ref": "#/$defs/nonnegative"},
    "summed_generation_seconds": {"type": "number", "minimum": 0},
    "summed_capacity_floor_ns": {"$ref": "#/$defs/nonnegative"},
    "summed_capacity_floor_seconds": {"type": "number", "minimum": 0},
    "summed_generation_over_capacity_floor": {"type": ["number", "string"]},
    "capacity_floor_efficiency": {"type": ["number", "string"]},
    "wall_minus_summed_generation_ns": {"type": "integer"},
    "compiler_work_ns": {"$ref": "#/$defs/nonnegative"},
    "timeline_snapshot_interval_ns": {"$ref": "#/$defs/positive"},
    "timeline_active_ns": {"$ref": "#/$defs/nonnegative"},
    "timeline_records": {"$ref": "#/$defs/nonnegative"},
    "timeline_snapshots": {"$ref": "#/$defs/nonnegative"},
    "timeline_gaps": {"$ref": "#/$defs/nonnegative"},
    "timeline_state_coverage": {"type": "object"},
    "selected_main_protocol": {"enum": [43, 50]},
    "selected_cache_wire": {"enum": ["off", "v1"]},
    "selected_codec_profile": {"type": "string", "minLength": 1},
    "compile_result": {"const": "pass"}
  },
  "$defs": {
    "nonnegative": {"type": "integer", "minimum": 0},
    "positive": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
