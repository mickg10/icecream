{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icecream-experiment-v2",
  "title": "Icecream mode-neutral experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "name", "seed", "components", "capabilities", "topology",
    "workload", "environment", "cache", "expected"
  ],
  "properties": {
    "schema": { "const": "icecream-experiment-v2" },
    "name": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler", "wrapper", "c_daemon", "f_daemon"],
      "properties": {
        "scheduler": { "$ref": "#/$defs/component" },
        "wrapper": { "$ref": "#/$defs/component" },
        "c_daemon": { "$ref": "#/$defs/component" },
        "f_daemon": { "$ref": "#/$defs/component" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_wire", "codec_profile"],
      "properties": {
        "cache_wire": { "enum": ["off", "v1"] },
        "codec_profile": {
          "enum": [
            "legacy", "zstd_tu", "p29", "grz", "z3_long", "z3_shared_long"
          ]
        },
        "experiment_control": {
          "description": "Non-product controls; z3_shared_long_b1 is the prebuilt-prefix comparison only.",
          "enum": ["compile_only", "raw", "z3_shared_long_b1"]
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c_count", "f_count", "f_slots", "bandwidth", "scheduler_policy",
        "assignment_source"
      ],
      "properties": {
        "c_count": { "type": "integer", "minimum": 1 },
        "f_count": { "type": "integer", "minimum": 1 },
        "f_slots": { "type": "integer", "minimum": 1 },
        "input_staging_slots": { "type": "integer", "minimum": 1 },
        "bandwidth": { "$ref": "#/$defs/network" },
        "scheduler_policy": {
          "enum": ["round_robin", "rendezvous", "dense_frontier"]
        },
        "dense_frontier_workers": { "type": "integer", "minimum": 1 },
        "assignment_source": { "enum": ["policy", "route_trace"] },
        "route_trace": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "scheduler_policy": { "const": "dense_frontier" } } },
          "then": { "required": ["dense_frontier_workers"] }
        },
        {
          "if": { "properties": { "assignment_source": { "const": "route_trace" } } },
          "then": { "required": ["route_trace"] },
          "else": { "not": { "required": ["route_trace"] } }
        }
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_policy", "jobs"],
      "properties": {
        "release_policy": { "const": "all_at_once" },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "c_index", "trace", "corpus_root", "manifest_digest",
              "compile_profile", "build_epochs", "build_release"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "c_index": { "type": "integer", "minimum": 0 },
              "trace": { "type": "string", "minLength": 1 },
              "corpus_root": { "type": "string", "minLength": 1 },
              "manifest_digest": { "$ref": "#/$defs/sha256" },
              "compile_profile": { "type": "string", "minLength": 1 },
              "build_epochs": { "type": "integer", "minimum": 1 },
              "build_release": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["after-previous", "concurrent", "fixed-interval"] },
                  "interval_ns": { "type": "integer", "minimum": 0 },
                  "gap_ns": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_state", "image_digest", "transfer_bytes", "install_verify_ns"],
      "properties": {
        "initial_state": { "enum": ["resident", "absent"] },
        "image_digest": { "$ref": "#/$defs/sha256" },
        "transfer_bytes": { "type": "integer", "minimum": 0 },
        "install_verify_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_state", "capacity_bytes", "lifecycle_events"],
      "properties": {
        "initial_state": { "enum": ["cold", "warm", "snapshot"] },
        "capacity_bytes": { "type": "integer", "minimum": 1 },
        "lifecycle_events": {
          "description": "Reserved for the later restart/eviction slice.",
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_main_protocol", "selected_cache_wire", "selected_codec_profile",
        "compile_result"
      ],
      "properties": {
        "selected_main_protocol": { "enum": [43, 50] },
        "selected_cache_wire": { "enum": ["off", "v1"] },
        "selected_codec_profile": { "$ref": "#/$defs/codec" },
        "compile_result": { "const": "pass" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "codec": {
      "enum": [
        "legacy", "zstd_tu", "p29", "grz", "z3_long", "z3_shared_long"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "main_protocol", "commit"],
      "properties": {
        "release": { "type": "string", "minLength": 1 },
        "main_protocol": { "enum": [43, 50] },
        "commit": { "$ref": "#/$defs/commit" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bits_per_second", "one_way_latency_ns", "lanes_per_endpoint"],
      "properties": {
        "bits_per_second": { "type": "integer", "minimum": 1 },
        "per_environment_bits_per_second": { "type": "integer", "minimum": 1 },
        "per_worker_bits_per_second": { "type": "integer", "minimum": 1 },
        "fabric_bits_per_second": { "type": "integer", "minimum": 1 },
        "writer_quantum_bytes": { "type": "integer", "minimum": 1 },
        "max_priority_burst_quanta": { "type": "integer", "minimum": 1 },
        "one_way_latency_ns": { "type": "integer", "minimum": 0 },
        "lanes_per_endpoint": { "type": "integer", "minimum": 1 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c_to_f", "f_to_c"],
      "properties": {
        "c_to_f": { "$ref": "#/$defs/link" },
        "f_to_c": { "$ref": "#/$defs/link" },
        "shared_fabric_bps": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [
        { "required": ["shared_fabric_bps"] },
        {
          "properties": {
            "c_to_f": { "required": ["fabric_bits_per_second"] },
            "f_to_c": { "required": ["fabric_bits_per_second"] }
          }
        }
      ]
    }
  }
}
