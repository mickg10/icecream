{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icecream-execution-v2-input",
  "title": "Icecream execution realization header",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "scenario_digest", "mode", "runner_commit", "host_manifest",
    "started_at", "source_commit", "simulator_commit", "codec_executable_digest",
    "input_manifest_digests", "image_identifiers", "compiler_versions",
    "library_versions", "host_identities"
  ],
  "properties": {
    "schema": { "const": "icecream-execution-v2" },
    "scenario_digest": { "$ref": "#/$defs/sha256" },
    "mode": { "enum": ["simulated", "physical"] },
    "runner_commit": { "$ref": "#/$defs/commit" },
    "host_manifest": { "$ref": "#/$defs/sha256" },
    "started_at": { "type": "string", "minLength": 1 },
    "source_commit": { "$ref": "#/$defs/commit" },
    "simulator_commit": { "$ref": "#/$defs/commit" },
    "codec_executable_digest": { "$ref": "#/$defs/sha256" },
    "input_manifest_digests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "image_identifiers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "compiler_versions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "library_versions": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "host_identities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
