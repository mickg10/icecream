        {"path": "released.a0", "from": false, "to": true},
        {"path": "schedulerReservation.a0", "from": true, "to": false},
        {"path": "terminalCount.a0", "from": 0, "to": 1}
      ]
    }
  ],
  "required_subsequence": [
    "Prepare.a0",
    "ClaimToken.a0",
    "MutantConsumeRevokedWhileClaimed.a0"
