    {
      "after": "EnqueueSecondFrame",
      "emit": "assert_concrete_and_quotient_queues_both_reach_depth_two",
      "actor": "formal-controller"
    }
  ],
  "metadata": {
    "module": "F2SQuotientSimulation",
    "config": "F2SQuotientTwoFrameWitness.cfg",
