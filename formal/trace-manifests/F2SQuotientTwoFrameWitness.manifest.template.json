{
  "schema": 1,
  "scenario": "F2SQuotientTwoFrameWitness",
  "property": "NoTwoFrameQueue",
  "expected_result": "counterexample",
  "min_states": 3,
  "event_mode": "exclusive",
  "events": [
    {
      "name": "EnqueueFirstFrame",
      "all": [
        {"path": "enqueueCount", "from": 0, "to": 1},
        {"path": "nextSequence", "from": 0, "to": 1},
        {"path": "consumeCount", "to": 0},
        {"path": "abstractLastIndex", "to": 0},
        {"path": "concreteLastIndex", "to": 0}
      ]
    },
    {
      "name": "EnqueueSecondFrame",
      "all": [
        {"path": "enqueueCount", "from": 1, "to": 2},
        {"path": "nextSequence", "from": 1, "to": 2},
        {"path": "consumeCount", "to": 0},
        {"path": "abstractLastIndex", "to": 0},
        {"path": "concreteLastIndex", "to": 0}
      ]
    }
  ],
  "required_subsequence": [
    "EnqueueFirstFrame",
    "EnqueueSecondFrame"
  ],
  "final_all": [
    {"path": "enqueueCount", "eq": 2},
    {"path": "nextSequence", "eq": 2},
    {"path": "consumeCount", "eq": 0},
    {"path": "abstractLastIndex", "eq": 0},
    {"path": "concreteLastIndex", "eq": 0}
  ],
  "harness_steps": [
    {
