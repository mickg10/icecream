{
  "schema": 1,
  "scenario": "AssignmentFenceNetworkDefaultAllowMutant",
  "property": "NoStartAfterRelease",
  "expected_result": "counterexample",
  "min_states": 8,
  "event_mode": "exclusive",
  "events": [
    {
      "name": "SPrepare.a1",
      "all": [
        {"path": "phase.a1", "from": "Absent", "to": "PrepareQueued"}
      ]
    },
    {
      "name": "FReceivePrepare.a1",
      "all": [
        {"path": "phase.a1", "from": "PrepareQueued", "to": "Prepared"},
        {"path": "workerSlot.a1", "from": false, "to": true}
      ]
    },
    {
      "name": "SReceiveReady.a1",
      "all": [
        {"path": "readySeen.a1", "from": false, "to": true},
        {"path": "phase.a1", "from": "Prepared", "to": "Ready"}
      ]
    },
    {
      "name": "SQueueRevoke.a1",
      "all": [
        {"path": "phase.a1", "from": "Ready", "to": "RevokeQueued"},
        {"path": "s2f", "len_delta": 1}
      ]
    },
    {
      "name": "FInstallFenceAndQueueRevoked.a1",
      "all": [
        {"path": "revokedEnqueued.a1", "from": false, "to": true},
        {"path": "workerSlot.a1", "from": true, "to": false},
        {"path": "fState.a1", "to": "Revoked"}
      ]
    },
    {
      "name": "SConsumeRevoked.a1",
      "all": [
        {"path": "revokedConsumed.a1", "from": false, "to": true},
        {"path": "released.a1", "from": false, "to": true},
        {"path": "phase.a1", "to": "Terminal"}
      ]
    },
    {
      "name": "CompactRevoked.a1",
      "all": [
        {"path": "fState.a1", "from": "Revoked", "to": "None"},
        {"path": "released.a1", "to": true}
      ]
    },
    {
      "name": "DelayedLegacyClaimStartsAfterRelease.a1",
      "all": [
        {"path": "startAfterRelease.a1", "from": 0, "to": 1},
        {"path": "workerSlot.a1", "from": false, "to": true},
        {"path": "fState.a1", "from": "None", "to": "Started"}
      ]
    }
  ],
  "required_subsequence": [
    "SPrepare.a1",
    "FReceivePrepare.a1",
    "SReceiveReady.a1",
    "SQueueRevoke.a1",
    "FInstallFenceAndQueueRevoked.a1",
    "SConsumeRevoked.a1",
    "CompactRevoked.a1",
    "DelayedLegacyClaimStartsAfterRelease.a1"
  ],
  "final_all": [
    {"path": "released.a1", "eq": true},
    {"path": "startAfterRelease.a1", "eq": 1},
    {"path": "workerSlot.a1", "eq": true}
  ],
  "harness_steps": [
    {
      "after": "SConsumeRevoked.a1",
      "emit": "barrier_after_scheduler_release",
      "actor": "scheduler"
    },
    {
      "after": "CompactRevoked.a1",
      "emit": "compact_terminal_assignment_record",
      "actor": "worker"
    },
    {
      "after": "DelayedLegacyClaimStartsAfterRelease.a1",
      "emit": "assert_delayed_legacy_claim_started_after_release",
      "actor": "worker"
    }
  ],
  "metadata": {
    "module": "AssignmentFenceNetworkCompaction",
    "config": "AssignmentFenceNetworkDefaultAllowMutant.cfg",
    "mutant": "MutantDefaultAllowUnknown = TRUE"
  }
}
