{
  "schema": 1,
  "scenario": "UseCSHandoffCut2Witness",
  "property": "NoFailureAt2",
  "expected_result": "counterexample",
  "min_states": 5,
  "event_mode": "exclusive",
  "events": [
    {
      "name": "BeginForwardWithExactId",
      "all": [
        {"path": "phase", "from": "Idle", "to": "Forwarding"},
        {"path": "exactIdKnown", "from": false, "to": true}
      ]
    },
    {
      "name": "WriteClientFrameByte",
      "all": [
        {"path": "phase", "from": "Forwarding", "to": "Forwarding"},
        {"path": "bytesWritten", "delta": 1},
        {"path": "frameCommitted", "to": false}
      ]
    },
    {
      "name": "FailInFrameBody",
      "all": [
        {"path": "phase", "from": "Forwarding", "to": "ExactAbortPending"},
        {"path": "failureObservedAt", "from": "NO_FAILURE", "to": 2},
        {"path": "bytesWritten", "to": 2},
        {"path": "frameCommitted", "to": false}
      ]
    }
  ],
  "required_subsequence": [
    "BeginForwardWithExactId",
    "WriteClientFrameByte",
    "WriteClientFrameByte",
    "FailInFrameBody"
  ],
  "final_all": [
    {"path": "phase", "eq": "ExactAbortPending"},
    {"path": "failureObservedAt", "eq": 2},
    {"path": "exactIdKnown", "eq": true},
    {"path": "frameCommitted", "eq": false}
  ],
  "harness_steps": [
    {
      "after": "WriteClientFrameByte",
      "occurrence": 2,
      "emit": "cut_usecs_in_frame_body",
      "actor": "client-channel"
    },
    {
      "after": "FailInFrameBody",
      "emit": "assert_exact_abort_pending_after_partial_body",
      "actor": "submitter-daemon"
    }
  ],
  "metadata": {
    "module": "UseCSHandoff",
    "config": "UseCSHandoffCut2Witness.cfg",
    "cut": "partial-body"
  }
}
