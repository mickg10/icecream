{
  "schema": 1,
  "scenario": "AssignmentFenceNetworkF2SBypassMutant",
  "property": "F2SStrictlyIncreasing",
  "expected_result": "counterexample",
  "min_states": 6,
  "event_mode": "exclusive",
  "events": [
    {
      "name": "FQueueFirstReady",
      "all": [
        {"path": "f2s", "from_len": 0, "to_len": 1},
        {"path": "nextF2SSeq", "delta": 1},
        {"path": "workerSlot", "changed": true},
        {"path": "phase", "changed": true}
      ]
    },
    {
      "name": "SQueueRevokeBehindReady",
      "all": [
        {"path": "s2f", "len_delta": 1},
        {"path": "f2s", "unchanged": true}
      ],
      "any": [
        {"path": "phase.a0", "to": "RevokeQueued"},
        {"path": "phase.a1", "to": "RevokeQueued"}
      ]
    },
    {
      "name": "FQueueSecondFrameBehindReady",
      "all": [
        {"path": "f2s", "from_len": 1, "to_len": 2},
        {"path": "nextF2SSeq", "delta": 1},
        {"path": "revokedEnqueued", "changed": true},
        {"path": "s2f", "len_delta": -1}
      ]
    },
    {
      "name": "SConsumeSecondF2SFrameFirst",
      "all": [
        {"path": "lastF2SConsumed", "from": 0, "to": 2},
        {"path": "f2s", "from_len": 2, "to_len": 1},
        {"path": "released", "changed": true}
      ]
    }
  ],
  "required_subsequence": [
    "FQueueFirstReady",
    "SQueueRevokeBehindReady",
    "FQueueSecondFrameBehindReady",
    "SConsumeSecondF2SFrameFirst"
  ],
  "final_all": [
    {"path": "lastF2SConsumed", "eq": 2},
    {"path": "f2s", "to_len": 1}
  ],
  "harness_steps": [
    {
      "after": "FQueueFirstReady",
      "emit": "hold_ready_as_fifo_predecessor",
      "actor": "f-to-s-transport"
    },
    {
      "after": "FQueueSecondFrameBehindReady",
      "emit": "queue_revoked_behind_ready",
      "actor": "fulfillment-daemon"
    },
    {
      "after": "SConsumeSecondF2SFrameFirst",
      "emit": "assert_scheduler_consumed_sequence_two_while_sequence_one_remained",
      "actor": "scheduler"
    }
  ],
  "metadata": {
    "module": "AssignmentFenceNetwork",
    "config": "AssignmentFenceNetworkF2SBypassMutant.cfg",
    "mutant": "MutantF2SBypass = TRUE",
    "load_bearing_fact": "The remaining queued frame has sequence 1 while lastF2SConsumed is 2."
  }
}
