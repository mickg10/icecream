        {"path": "readySeen.a1", "from": false, "to": true},
        {"path": "readySeen.a0", "to": false},
        {"path": "f2sBypassObserved", "from": false, "to": true},
        {"path": "f2s", "from_len": 2, "to_len": 1}
      ]
