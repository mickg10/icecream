{
  "schema": 1,
  "scenario": "LifecycleAuthorityStartedWitness",
  "property": "NoStartedState",
  "expected_result": "counterexample",
  "min_states": 2,
  "event_mode": "exclusive",
  "events": [
    {
      "name": "BeginFromAssignedWorker",
      "all": [
        {"path": "phase", "from": "Waiting", "to": "Started"},
        {"path": "begunEver", "from": false, "to": true},
        {"path": "dispatchDebit", "from": true, "to": false},
        {"path": "creditCount", "from": 0, "to": 1},
        {"path": "monitorBeginCount", "from": 0, "to": 1},
        {"path": "startRevision", "from": 0, "to": 1},
        {"path": "terminalCount", "to": 0}
      ]
    }
  ],
  "required_subsequence": ["BeginFromAssignedWorker"],
  "final_all": [
    {"path": "phase", "eq": "Started"},
    {"path": "begunEver", "eq": true},
    {"path": "dispatchDebit", "eq": false},
    {"path": "creditCount", "eq": 1},
    {"path": "monitorBeginCount", "eq": 1},
    {"path": "terminalCount", "eq": 0}
  ],
  "harness_steps": [
    {
      "after": "BeginFromAssignedWorker",
      "emit": "assert_started_state_is_reachable_from_assigned_worker_begin",
      "actor": "assigned-worker"
    }
  ],
  "metadata": {
    "module": "LifecycleAuthorityStartedWitness",
    "config": "LifecycleAuthorityStartedWitness.cfg",
    "witness": "The fixed lifecycle model reaches Started before the conditional worker-terminal liveness theorem is checked."
  }
}
