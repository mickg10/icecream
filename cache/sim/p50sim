#!/usr/bin/env python3
"""Run one authenticated Protocol-50 ZSTD_TU scenario."""

from __future__ import annotations

import hashlib
import json
import os
import stat
import subprocess
import sys
from pathlib import Path


MAX_INPUT_BYTES = 64 * 1024 * 1024
SCENARIO_SCHEMA = "icecream-s7-p50sim-scenario-v1"
SUPPORTED_PROFILES = ("ZSTD_TU", "ZSTD_ROUTE", "P29", "GRZ_RESIDUAL")
SUPPORTED_CELLS = frozenset(
    f"{corpus}/{profile}/{regime}"
    for corpus in ("fmt", "RocksDB")
    for profile in SUPPORTED_PROFILES
    for regime in ("cold", "warm")
)


def fail(message: str) -> int:
    print(f"p50sim: {message}", file=sys.stderr)
    return 1


def regular(path: Path) -> bool:
    try:
        info = path.lstat()
    except OSError:
        return False
    return stat.S_ISREG(info.st_mode) and not stat.S_ISLNK(info.st_mode) and info.st_nlink == 1


def digest(path: Path) -> tuple[str, bytes]:
    if not regular(path):
        raise ValueError(f"not a private regular file: {path.name}")
    value = path.read_bytes()
    if len(value) > MAX_INPUT_BYTES:
        raise ValueError("scenario input exceeds the bounded ZSTD_TU admission limit")
    return hashlib.sha256(value).hexdigest(), value


def canonical_json(path: Path) -> dict[str, object]:
    if not regular(path):
        raise ValueError(f"not a private regular file: {path.name}")
    raw = path.read_bytes()
    value = json.loads(raw)
    if not isinstance(value, dict):
        raise ValueError(f"{path.name} must contain an object")
    canonical = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    if raw.strip() != canonical:
        raise ValueError(f"{path.name} is not canonical JSON")
    return value


def canonical_jsonl(path: Path) -> list[dict[str, object]]:
    if not regular(path):
        raise ValueError(f"not a private regular file: {path.name}")
    rows: list[dict[str, object]] = []
    for line_number, raw_line in enumerate(path.read_bytes().splitlines(), 1):
        try:
            value = json.loads(raw_line)
        except json.JSONDecodeError as error:
            raise ValueError(f"action trace line {line_number} is not JSON") from error
        if not isinstance(value, dict):
            raise ValueError(f"action trace line {line_number} is not an object")
        rows.append(value)
    if not rows:
        raise ValueError("canonical live action trace is empty")
    return rows


def write_jsonl(path: Path, rows: list[dict[str, object]]) -> None:
    with path.open("wb") as stream:
        for row in rows:
            stream.write(json.dumps(row, sort_keys=True, separators=(",", ":")).encode())
            stream.write(b"\n")


def stage_ledger(rows: list[dict[str, object]]) -> list[dict[str, object]]:
    """Project the product trace to the exact byte-bearing stage ledger."""
    return [{
        "sequence": sequence,
        "action": row.get("action"),
        "actor": row.get("actor"),
        "stage_bytes": row.get("stage_bytes"),
        "transaction_digest": row.get("transaction_digest"),
        "raw_digest": row.get("raw_digest"),
    } for sequence, row in enumerate(rows, 1)]


def trace_identity(rows: list[dict[str, object]]) -> dict[str, object]:
    c_rows = [row for row in rows if row.get("actor") == "C"]
    f_rows = [row for row in rows if row.get("actor") == "F"]
    if not c_rows or not f_rows:
        raise ValueError("product action trace has no C/F roles")
    c_guid = c_rows[0].get("c_store_guid")
    f_guid = c_rows[0].get("f_store_guid")
    begins = [row for row in rows if row.get("action") == "TX_BEGIN"]
    if not isinstance(c_guid, str) or not isinstance(f_guid, str) or not begins:
        raise ValueError("product action trace has incomplete identity")
    return {
        "c_store_guid": c_guid,
        "f_store_guid": f_guid,
        "history_nonce": begins[0].get("history_nonce"),
        "prewarm_tu_seq": begins[0].get("tu_seq"),
        "measured_tu_seq": begins[-1].get("tu_seq"),
        "prewarm_rel_seq": begins[0].get("rel_seq"),
        "measured_rel_seq": begins[-1].get("rel_seq"),
        "prewarm_session_serial": begins[0].get("session_serial"),
        "measured_session_serial": begins[-1].get("session_serial"),
    }


def action_identity(row: dict[str, object]) -> tuple[object, ...]:
    """The existing Protocol-50 transaction identity carried by each action."""
    return tuple(row.get(field) for field in (
        "c_store_guid", "f_store_guid", "history_nonce", "rel_seq", "tu_seq",
        "transaction_digest", "raw_digest"))


def combine_process_traces(c_rows: list[dict[str, object]],
                           f_rows: list[dict[str, object]]) -> list[dict[str, object]]:
    """Merge role-local traces at the existing protocol action boundaries.

    Each role's order is retained.  The only cross-role decisions are the
    protocol's existing identity/order rules: C opens a transaction before F
    accepts that same transaction, F completes it before C accepts the commit,
    and a session disconnect follows that acceptance.  This keeps the reducer
    input deterministic without adding an event schema or wall-clock ordering.
    """
    if any(row.get("actor") != "C" for row in c_rows):
        raise ValueError("C action trace contains a non-C action")
    if any(row.get("actor") != "F" for row in f_rows):
        raise ValueError("F action trace contains a non-F action")
    merged: list[dict[str, object]] = []
    c_index = f_index = 0

    def transaction(row: dict[str, object]) -> bool:
        return row.get("action") in {
            "TX_BEGIN", "ACTIVE_REPLAYED", "DICT_COMPLETE", "NEED_RECORDED",
            "OBJECT_APPLIED", "BODY_COMPLETE", "INPUT_MATERIALIZED",
            "INPUT_COMMITTED", "COMMIT_ACCEPTED", "LOST_COMMIT_ACCEPTED",
        }

    while c_index < len(c_rows) or f_index < len(f_rows):
        c = c_rows[c_index] if c_index < len(c_rows) else None
        f = f_rows[f_index] if f_index < len(f_rows) else None
        if f is None:
            merged.append(c)
            c_index += 1
            continue
        if c is None:
            merged.append(f)
            f_index += 1
            continue
        f_action = f.get("action")
        c_action = c.get("action")
        # A warm reconnect may let C's next TX_BEGIN win the event-loop race
        # with F's SESSION_OPENED.  The session serial makes this ordering
        # unambiguous; preserve the observed product order instead of forcing
        # the cold-session prefix before it.
        if c_action == "TX_BEGIN" and f_action == "SESSION_OPENED" and \
                f.get("session_serial", 0) > 1:
            merged.append(c)
            c_index += 1
            continue
        if f_action in {"SESSION_OPENED", "SESSION_REPLACED", "HISTORY_RESET"}:
            merged.append(f)
            f_index += 1
        elif f_action == "SESSION_DISCONNECTED":
            # The F session can close only after C has observed the durable
            # commit when that acceptance is present in the C trace.
            if c_action in {"COMMIT_ACCEPTED", "LOST_COMMIT_ACCEPTED"}:
                merged.append(c)
                c_index += 1
            else:
                merged.append(f)
                f_index += 1
        elif c_action == "TX_BEGIN" and f_action == "TX_BEGIN" and \
                action_identity(c) == action_identity(f):
            merged.append(c)
            c_index += 1
        elif c_action in {"COMMIT_ACCEPTED", "LOST_COMMIT_ACCEPTED"} and \
                transaction(f) and action_identity(c) == action_identity(f):
            merged.append(f)
            f_index += 1
        elif c_action == "TX_BEGIN" and transaction(f):
            # F's next transaction action belongs to an earlier REL_SEQ; it
            # must drain before C can begin the next one.
            merged.append(f)
            f_index += 1
        elif f_action == "TX_BEGIN" and c_action == "TX_BEGIN":
            # A distinct F transaction is the next accepted route cursor.
            merged.append(f)
            f_index += 1
        elif c_action in {"COMMIT_ACCEPTED", "LOST_COMMIT_ACCEPTED"} and \
                action_identity(c) != action_identity(f):
            merged.append(c)
            c_index += 1
        elif c_action == "TX_BEGIN":
            merged.append(c)
            c_index += 1
        else:
            merged.append(f)
            f_index += 1
    return merged


def child(root: Path, name: object) -> Path:
    if not isinstance(name, str) or not name or Path(name).is_absolute():
        raise ValueError("scenario paths must be relative strings")
    path = (root / name).resolve()
    if root not in path.parents:
        raise ValueError("scenario path escapes its authenticated root")
    return path


def live_identity(rows: list[dict[str, object]]) -> tuple[str, str, int]:
    """Read the initial route identity from the authenticated live snapshot."""
    c_rows = [row for row in rows if row.get("actor") == "C"]
    f_rows = [row for row in rows if row.get("actor") == "F"]
    if not c_rows or not f_rows:
        raise ValueError("live action snapshot has no C/F identity")
    c_guid = c_rows[0].get("c_store_guid")
    f_guid = f_rows[0].get("f_store_guid")
    tx = next((row for row in rows if row.get("action") in {"TX_BEGIN", "ACTIVE_REPLAYED"}), None)
    nonce = tx.get("history_nonce") if tx else None
    if not isinstance(c_guid, str) or not isinstance(f_guid, str) or not isinstance(nonce, int):
        raise ValueError("live action snapshot has incomplete route identity")
    if len(c_guid) != 32 or len(f_guid) != 32 or nonce <= 0:
        raise ValueError("live action snapshot has invalid route identity")
    return c_guid, f_guid, nonce


def main(argv: list[str]) -> int:
    if len(argv) != 7 or argv[1] != "--s7-cell" or argv[3] != "--s7-artifacts" or argv[5] != "--s7-output":
        return fail("expected --s7-cell CELL --s7-artifacts DIR --s7-output DIR")
    cell, artifact_name, output_name = argv[2], argv[4], argv[6]
    artifacts = Path(artifact_name).absolute()
    output = Path(output_name).absolute()
    if not artifacts.is_dir() or artifacts.is_symlink():
        return fail("scenario root is unavailable")
    try:
        scenario = canonical_json(artifacts / "scenario.json")
        if scenario.get("schema") != SCENARIO_SCHEMA:
            raise ValueError("scenario schema is not supported")
        if scenario.get("cell") != cell:
            raise ValueError("scenario cell does not match the requested cell")
        if cell not in SUPPORTED_CELLS:
            # The matrix remains closed: unsupported profiles are an honest HOLD
            # until their production route has an explicit scenario manifest.
            (output / "execution_status.json").write_text(
                '{"schema":"icecream-p50sim-status-v1","status":"HOLD","reason":"scenario_profile_unavailable"}\n',
                encoding="utf-8",
            )
            return 0
        input_path = child(artifacts, scenario.get("input"))
        route_path = child(artifacts, scenario.get("route_trace"))
        action_path = child(artifacts, scenario.get("action_trace"))
        warm = scenario.get("regime") == "warm" or "prewarm_input" in scenario
        prewarm_input_path = child(artifacts, scenario.get("prewarm_input")) if warm else None
        input_sha, _ = digest(input_path)
        route_sha, _ = digest(route_path)
        action_sha, _ = digest(action_path)
        prewarm_input_sha = None
        if prewarm_input_path is not None:
            prewarm_input_sha, _ = digest(prewarm_input_path)
        if scenario.get("input_sha256") != input_sha:
            raise ValueError("scenario input digest mismatch")
        if warm and scenario.get("prewarm_input_sha256") != prewarm_input_sha:
            raise ValueError("scenario prewarm input digest mismatch")
        if scenario.get("route_trace_sha256") != route_sha:
            raise ValueError("canonical route trace digest mismatch")
        if scenario.get("action_trace_sha256") != action_sha:
            raise ValueError("canonical live action trace digest mismatch")
        route = canonical_json(route_path)
        if route.get("schema") != "icecream-s7-live-route-trace-v1" or route.get("origin") != "live":
            raise ValueError("route trace is not a canonical live trace")
        if not isinstance(route.get("trace"), list) or not route["trace"]:
            raise ValueError("canonical live route trace is empty")
        expected_actions = canonical_jsonl(action_path)
        c_guid, f_guid, history_nonce = live_identity(expected_actions)
        configured_identity = scenario.get("identity")
        if configured_identity is not None:
            if not isinstance(configured_identity, dict):
                raise ValueError("scenario identity must be an object")
            for key, value in (("c_store_guid", c_guid), ("f_store_guid", f_guid),
                               ("history_nonce", history_nonce)):
                if configured_identity.get(key) != value:
                    raise ValueError("scenario identity differs from live action snapshot")
        if route.get("actions") != [row.get("action") for row in expected_actions]:
            raise ValueError("route trace action sequence differs from live action trace")
        expected_route = [
            {"action": row.get("action"), "sequence": sequence}
            for sequence, row in enumerate(expected_actions, 1)
        ]
        if route.get("trace") != expected_route:
            raise ValueError("route trace stages differ from live action trace")
        binary = Path(__file__).with_name(".p50sim.bin")
        if not regular(binary) or not os.access(binary, os.X_OK):
            raise ValueError("p50sim production binary is not built")
        output.mkdir(parents=True, exist_ok=True)
        actions = output / "actions.jsonl"
        summary = output / "execution.json"
        c_process_trace = output / "c-action-trace.jsonl"
        f_process_trace = output / "f-action-trace.jsonl"
        execution_environment = os.environ.copy()
        execution_environment["ICECC_P50_C_ACTION_TRACE"] = str(c_process_trace)
        execution_environment["ICECC_P50_F_ACTION_TRACE"] = str(f_process_trace)
        command = [str(binary)]
        if warm:
            prewarm_actions = output / "prewarm-actions.jsonl"
            measured_actions = output / "measured-actions.jsonl"
            command += ["--prewarm-input", str(prewarm_input_path),
                        "--measured-input", str(input_path),
                        "--prewarm-actions", str(prewarm_actions),
                        "--measured-actions", str(measured_actions)]
        else:
            prewarm_actions = measured_actions = None
            command += ["--input", str(input_path)]
        command += ["--actions", str(actions), "--summary", str(summary),
                    "--c-store-guid", c_guid, "--f-store-guid", f_guid,
                    "--history-nonce", str(history_nonce)]
        result = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            env=execution_environment,
            check=False,
        )
        if result.returncode:
            return result.returncode
        if not regular(actions) or not regular(summary):
            raise ValueError("production execution omitted action or summary evidence")
        # The C++ endpoint writes the authoritative Protocol-50 trace. Keep a
        # separate digest witness so later adapters cannot substitute a fixture.
        produced_action_sha, _ = digest(actions)
        produced_actions = canonical_jsonl(actions)
        c_process_actions = canonical_jsonl(c_process_trace)
        f_process_actions = canonical_jsonl(f_process_trace)
        if combine_process_traces(c_process_actions, f_process_actions) != produced_actions:
            raise ValueError("deterministic C/F action merge differs from endpoint reducer trace")
        if produced_actions != expected_actions:
            raise ValueError("production replay differs from canonical live action trace")
        if not warm and isinstance(scenario.get("measured_action_trace"), str):
            expected_measured = canonical_jsonl(
                child(artifacts, scenario.get("measured_action_trace")))
            if produced_actions != expected_measured:
                raise ValueError("measured action trace differs from product trace")
        if warm:
            for field in ("prewarm_action_trace", "measured_action_trace",
                          "prewarm_c_action_trace", "prewarm_f_action_trace",
                          "measured_c_action_trace", "measured_f_action_trace"):
                if not isinstance(scenario.get(field), str):
                    raise ValueError(f"warm scenario is missing explicit {field}")
            produced_prewarm = canonical_jsonl(prewarm_actions)
            produced_measured = canonical_jsonl(measured_actions)
            expected_prewarm = canonical_jsonl(
                child(artifacts, scenario.get("prewarm_action_trace")))
            expected_measured = canonical_jsonl(
                child(artifacts, scenario.get("measured_action_trace")))
            if produced_prewarm != expected_prewarm:
                raise ValueError("prewarm TU0 action trace differs from product trace")
            if produced_measured != expected_measured:
                raise ValueError("measured TU1 action trace differs from product trace")
            expected_c = scenario.get("prewarm_c_action_trace")
            expected_f = scenario.get("prewarm_f_action_trace")
            if expected_c is not None and canonical_jsonl(child(artifacts, expected_c)) != \
                    [row for row in produced_prewarm if row.get("actor") == "C"]:
                raise ValueError("prewarm C action trace differs from product trace")
            if expected_f is not None and canonical_jsonl(child(artifacts, expected_f)) != \
                    [row for row in produced_prewarm if row.get("actor") == "F"]:
                raise ValueError("prewarm F action trace differs from product trace")
            expected_c = scenario.get("measured_c_action_trace")
            expected_f = scenario.get("measured_f_action_trace")
            if expected_c is not None and canonical_jsonl(child(artifacts, expected_c)) != \
                    [row for row in produced_measured if row.get("actor") == "C"]:
                raise ValueError("measured C action trace differs from product trace")
            if expected_f is not None and canonical_jsonl(child(artifacts, expected_f)) != \
                    [row for row in produced_measured if row.get("actor") == "F"]:
                raise ValueError("measured F action trace differs from product trace")
            write_jsonl(output / "prewarm-c-action-trace.jsonl",
                        [row for row in produced_prewarm if row.get("actor") == "C"])
            write_jsonl(output / "prewarm-f-action-trace.jsonl",
                        [row for row in produced_prewarm if row.get("actor") == "F"])
            write_jsonl(output / "measured-c-action-trace.jsonl",
                        [row for row in produced_measured if row.get("actor") == "C"])
            write_jsonl(output / "measured-f-action-trace.jsonl",
                        [row for row in produced_measured if row.get("actor") == "F"])
        identities = trace_identity(produced_actions)
        configured_identity = scenario.get("identity")
        if isinstance(configured_identity, dict):
            for key in ("c_store_guid", "f_store_guid", "history_nonce"):
                if configured_identity.get(key) != identities.get(key):
                    raise ValueError("product action identity differs from scenario identity")
            if warm and (configured_identity.get("prewarm_tu_seq") not in (None, 0) or
                          configured_identity.get("measured_tu_seq") not in (None, 1)):
                raise ValueError("warm TU identity does not name TU0 then TU1")
        ledger = stage_ledger(produced_actions)
        write_jsonl(output / "stage-ledger.jsonl", ledger)
        expected_ledger_name = scenario.get("stage_ledger")
        if expected_ledger_name is not None and ledger != canonical_jsonl(
                child(artifacts, expected_ledger_name)):
            raise ValueError("stage-byte ledger differs from product trace")
        (output / "identities.json").write_bytes(
            (json.dumps(identities, sort_keys=True, separators=(",", ":")) + "\n").encode())
        summary_value = json.loads(summary.read_bytes())
        if not isinstance(summary_value, dict):
            raise ValueError("production execution summary is not an object")
        if summary_value.get("schema") != "icecream-p50sim-execution-v1":
            raise ValueError("production execution schema mismatch")
        (output / "execution_status.json").write_text(
            json.dumps({
                "schema": "icecream-p50sim-status-v1",
                "status": "EXECUTED",
                "cell": cell,
                "input_sha256": input_sha,
                "route_trace_sha256": route_sha,
                "action_trace_sha256": produced_action_sha,
            }, sort_keys=True, separators=(",", ":")) + "\n",
            encoding="utf-8",
        )
        return 0
    except (OSError, ValueError, json.JSONDecodeError) as error:
        return fail(str(error))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
