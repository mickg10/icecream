set -euo pipefail
./autogen.sh
./configure --without-libcap_ng
make -j2 -C services
make -j2 -C scheduler icecc-scheduler
make -j2 -C unittests siblingpin siblingpin_mutant
make -C unittests check \
  TESTS='siblingpin siblingpin-negative.sh' \
  check_PROGRAMS='siblingpin siblingpin_mutant'
git diff --check
