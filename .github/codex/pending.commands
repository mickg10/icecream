set -euo pipefail
./autogen.sh
./configure --without-libcap_ng
make -j2 -C services
make -j2 -C scheduler icecc-scheduler
make -j2 -C unittests statsapply statsapply_mutant
make -C unittests check \
  TESTS='statsapply statsapply-negative.sh' \
  check_PROGRAMS='statsapply statsapply_mutant'
git diff --check
