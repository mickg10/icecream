set -euo pipefail
./autogen.sh
./configure --without-libcap_ng
make -j2 -C services
make -j2 -C scheduler icecc-scheduler
make -j2 -C unittests relisten
for iteration in 1 2 3 4 5; do
  echo "# relisten iteration ${iteration}"
  ./unittests/relisten ./scheduler/icecc-scheduler
done
make -C unittests check TESTS='relisten-quick.sh' check_PROGRAMS=relisten
git diff --check
