{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icefarm-suite-v1",
  "title": "Icecream controlled-farm suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id"],
  "properties": {
    "schema": {"const": "icefarm-suite-v1"},
    "id": {"$ref": "#/$defs/name"},
    "kind": {"enum": ["generic", "controls", "smoke", "s50-fairness", "s60-transitions", "s70-resilience", "composite"]},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "repetitions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "arms"],
      "properties": {
        "kind": {"const": "s80"},
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["P29V1", "ZSTD_TU", "ZSTD_ROUTE", "legacy"],
          "properties": {
            "P29V1": {"$ref": "#/$defs/name"},
            "ZSTD_TU": {"$ref": "#/$defs/name"},
            "ZSTD_ROUTE": {"$ref": "#/$defs/name"},
            "legacy": {"$ref": "#/$defs/name"}
          }
        }
      }
    },
    "fairness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "mixed", "ratio_limit"],
      "properties": {
        "control": {"$ref": "#/$defs/name"},
        "mixed": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "ratio_limit": {"type": "number", "exclusiveMinimum": 1, "maximum": 2}
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
