{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icecream.dev/schemas/icefarm-farm-v1.json",
  "title": "Icecream controlled farm specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "hub",
    "registry",
    "image_transport",
    "netname_prefix",
    "port_range",
    "hosts",
    "corpora",
    "runtime_image",
    "client_environments",
    "protected",
    "authority"
  ],
  "properties": {
    "schema": {"const": "icefarm-farm-v1"},
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results_root"],
      "properties": {
        "results_root": {"type": "string", "pattern": "^/", "minLength": 2}
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "mode"],
      "properties": {
        "host": {"$ref": "#/$defs/name"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "mode": {"enum": ["registry", "save-load", "auto"]}
      }
    },
    "image_transport": {"$ref": "#/$defs/image_transport"},
    "netname_prefix": {"$ref": "#/$defs/name"},
    "port_range": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1024, "maximum": 65535},
        {"type": "integer", "minimum": 1024, "maximum": 65535}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/host"}
    },
    "corpora": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/corpus"}
    },
    "runtime_image": {"$ref": "#/$defs/runtime_image"},
    "client_environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/client_environment"}
    },
    "system_source_snapshots": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/system_source_snapshot"}
    },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_patterns", "never_touch_labels_other_than"],
      "properties": {
        "process_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "never_touch_labels_other_than": {"const": "icefarm.*"}
      }
    },
    "authority": {"$ref": "#/$defs/authority"},
    "authority_capture": {"$ref": "#/$defs/authority_capture"},
    "s8_capture": {"type": "object"}
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ssh",
        "lan_ip",
        "arch",
        "cores",
        "mem_gb",
        "scratch_root",
        "roles_allowed",
        "sudo",
        "netem",
        "shared_lan"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "ssh": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "docker_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "lan_ip": {"type": "string", "minLength": 3, "maxLength": 64},
        "arch": {"type": "string", "minLength": 1, "maxLength": 32},
        "cores": {"type": "integer", "minimum": 1},
        "mem_gb": {"type": "integer", "minimum": 1},
        "scratch_root": {"type": "string", "pattern": "^/", "minLength": 2},
        "roles_allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["S", "F", "C"]}
        },
        "sudo": {"type": "boolean"},
        "netem": {"type": "boolean"},
        "shared_lan": {"type": "string", "minLength": 3, "maxLength": 80}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tus", "compression", "archives"],
      "properties": {
        "kind": {"enum": ["cmake-project", "ii-manifest", "tu-manifest"]},
        "hub_path": {"type": "string", "pattern": "^/", "minLength": 2},
        "tus": {"type": "integer", "minimum": 1},
        "repeat": {"type": "integer", "minimum": 1},
        "root": {"type": "string", "pattern": "^/", "minLength": 2},
        "manifest": {"type": "string", "pattern": "^/", "minLength": 2},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "turn_a": {"type": "string", "minLength": 1},
        "turn_b": {"type": "string", "minLength": 1},
        "turn_a_manifest": {"type": "string", "pattern": "^/", "minLength": 2},
        "turn_b_manifest": {"type": "string", "pattern": "^/", "minLength": 2},
        "normalized_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "pair_index_sha256": {"$ref": "#/$defs/sha256"},
        "authority_receipt": {"$ref": "#/$defs/corpus_authority_receipt"},
        "compression": {"$ref": "#/$defs/corpus_compression"},
        "archives": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/corpus_archive"}
        },
        "compiler_recipes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/compiler_recipe"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "cmake-project"}}},
          "then": {"required": ["hub_path"]}
        },
        {
          "if": {"properties": {"kind": {"const": "ii-manifest"}}},
          "then": {"required": ["hub_path", "turn_a", "turn_b"]}
        },
        {
          "if": {"properties": {"kind": {"const": "tu-manifest"}}},
          "then": {"required": ["root"]}
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "image_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^p(43|44|50)(s[0-9]+)?-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "hosts",
        "role_stores",
        "images",
        "topologies"
      ],
      "properties": {
        "schema": {"const": "icecream-newgen-farm-authority-v1"},
        "hosts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/authority_host"}
        },
        "role_stores": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^(43|44|50)$"},
          "additionalProperties": {"$ref": "#/$defs/role_store"}
        },
        "images": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/image_label"},
          "additionalProperties": {"$ref": "#/$defs/image_binding"}
        },
        "topologies": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/topology"}
        }
      }
    },
    "authority_host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "address"],
      "properties": {
        "class": {"enum": ["submission", "orchestration", "worker"]},
        "address": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "authority_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "authority_sha256", "captured_at", "hosts"],
      "properties": {
        "schema": {"const": "icecream-newgen-authority-capture-v2"},
        "authority_sha256": {"$ref": "#/$defs/sha256"},
        "captured_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "hosts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/authority_capture_host"}
        }
      }
    },
    "authority_capture_host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "arch",
        "boot_id_sha256",
        "captured_at",
        "cpu_count",
        "docker",
        "hostname",
        "machine_id_sha256",
        "mem_bytes",
        "nic_identity_sha256",
        "physical_host_sha256"
      ],
      "properties": {
        "address": {"type": "string", "minLength": 3, "maxLength": 64},
        "arch": {"type": "string", "minLength": 1, "maxLength": 32},
        "boot_id_sha256": {"$ref": "#/$defs/sha256"},
        "captured_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "cpu_count": {"type": "integer", "minimum": 1},
        "docker": {"$ref": "#/$defs/authority_capture_docker"},
        "hostname": {"type": "string", "minLength": 1, "maxLength": 255},
        "machine_id_sha256": {"$ref": "#/$defs/sha256"},
        "mem_bytes": {"type": "integer", "minimum": 1},
        "nic_identity_sha256": {"$ref": "#/$defs/sha256"},
        "physical_host_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority_capture_docker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "mem_bytes", "name", "os", "root_dir", "server_version"],
      "properties": {
        "arch": {"type": "string", "minLength": 1, "maxLength": 32},
        "mem_bytes": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "os": {"const": "linux"},
        "root_dir": {"type": "string", "pattern": "^/", "minLength": 2},
        "server_version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "role_store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler", "client", "daemon"],
      "properties": {
        "scheduler": {"$ref": "#/$defs/role_binary"},
        "client": {"$ref": "#/$defs/role_binary"},
        "daemon": {"$ref": "#/$defs/role_binary"}
      }
    },
    "role_binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}}
    },
    "image_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "archive_sha256"],
      "properties": {
        "kind": {"enum": ["scheduler-mutant", "daemon-mutant"]},
        "base_image": {"$ref": "#/$defs/image_label"},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_archive_sha256": {"$ref": "#/$defs/sha256"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "cache_wire_revision": {"type": "integer", "minimum": 1, "maximum": 65535},
        "closure_sha256": {"$ref": "#/$defs/sha256"},
        "id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "patch_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "patch_sha256": {"$ref": "#/$defs/sha256"},
        "recipe_schema": {"enum": ["icefarm-scheduler-mutant-recipe-v1", "icefarm-daemon-mutant-recipe-v1"]},
        "recipe_sha256": {"$ref": "#/$defs/sha256"},
        "role_overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scheduler": {"$ref": "#/$defs/role_binary"},
            "daemon": {"$ref": "#/$defs/role_binary"}
          }
        }
      }
    },
    "compiler_recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "binary_sha256",
        "configuration_sha256",
        "version",
        "arguments"
      ],
      "properties": {
        "executable": {"type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1, "maxLength": 512},
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "toolchain": {"$ref": "#/$defs/toolchain"}
      }
    },
    "corpus_compression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec", "level", "long", "threads", "checksum"],
      "properties": {
        "codec": {"const": "zstd"},
        "level": {"const": 19},
        "long": {"const": 31},
        "threads": {"const": 8},
        "checksum": {"const": true}
      }
    },
    "image_transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec", "level", "long", "threads", "checksum"],
      "properties": {
        "codec": {"const": "zstd"},
        "level": {"const": 19},
        "long": {"const": 31},
        "threads": {"const": 8},
        "checksum": {"const": true}
      }
    },
    "corpus_archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive",
        "archive_bytes",
        "archive_sha256",
        "authority_sha256",
        "files",
        "manifest_sha256",
        "unpacked_bytes"
      ],
      "properties": {
        "archive": {"type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096},
        "archive_bytes": {"type": "integer", "minimum": 1},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "authority_sha256": {"$ref": "#/$defs/sha256"},
        "files": {"type": "integer", "minimum": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "unpacked_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "corpus_authority_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive",
        "archive_bytes",
        "archive_sha256",
        "compression",
        "mount",
        "unpacked_bytes"
      ],
      "properties": {
        "archive": {"type": "string", "pattern": "^/", "minLength": 2},
        "archive_bytes": {"type": "integer", "minimum": 1},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "compression": {"$ref": "#/$defs/corpus_compression"},
        "mount": {"type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096},
        "unpacked_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "runtime_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "id", "closure_sha256", "dockerfile"],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]*$"
        },
        "id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "closure_sha256": {"$ref": "#/$defs/sha256"},
        "dockerfile": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "client_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "id", "closure_sha256", "dockerfile"],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:+-]*$"
        },
        "id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "closure_sha256": {"$ref": "#/$defs/sha256"},
        "dockerfile": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "system_source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source", "source_runtime_reference", "source_runtime_id", "source_runtime_closure_sha256", "manifest_sha256", "file_count", "enumeration", "archive"],
      "properties": {
        "schema": {"const": "icefarm-system-source-snapshot-v1"},
        "source": {"const": "runtime"},
        "source_runtime_reference": {"type": "string", "minLength": 1, "maxLength": 255},
        "source_runtime_id": {"$ref": "#/$defs/image_id"},
        "source_runtime_closure_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "enumeration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "roots", "symlink_policy"],
          "properties": {
            "schema": {"const": "icefarm-system-source-manifest-v1"},
            "roots": {
              "const": ["/usr/include", "/usr/lib/gcc", "/usr/local/include"]
            },
            "symlink_policy": {
              "const": "no-directory-follow;regular-file-symlinks-regularized"
            }
          }
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "archive_bytes", "unpacked_bytes", "compression"],
          "properties": {
            "path": {"type": "string", "pattern": "^/", "minLength": 2},
            "sha256": {"$ref": "#/$defs/sha256"},
            "archive_bytes": {"type": "integer", "minimum": 1},
            "unpacked_bytes": {"type": "integer", "minimum": 1},
            "compression": {
              "type": "object",
              "additionalProperties": false,
              "required": ["codec", "level", "long", "threads", "checksum"],
              "properties": {
                "codec": {"const": "zstd"},
                "level": {"const": 19},
                "long": {"const": 31},
                "threads": {"const": 8},
                "checksum": {"const": true}
              }
            }
          }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["f_relationships", "slots_per_f"],
      "properties": {
        "f_relationships": {"type": "integer", "minimum": 1},
        "slots_per_f": {"type": "integer", "minimum": 1}
      }
    }
  }
}
