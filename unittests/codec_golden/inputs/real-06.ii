      (value < 0 || to_unsigned(value) > to_unsigned(upper))) {
    ::fmt::detail::assert_fail("/tanksmall/scratch/ictmp/src3/gecko-dev/obj-cc/dist/include/fmt/chrono.h", 1008, (fmt::format_error("chrono value is out of range")).what());
