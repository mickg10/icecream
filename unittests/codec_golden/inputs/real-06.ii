# 16 "/tanksmall/scratch/ictmp/src3/gecko-dev/obj-cc/dist/include/nsAlgorithm.h"
template <class T>
inline const T& XPCOM_MIN(const T& aA, const T& aB) {
  return aB < aA ? aB : aA;
}


template <class T>
inline const T& XPCOM_MAX(const T& aA, const T& aB) {
  return aA > aB ? aA : aB;
}
