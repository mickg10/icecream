template <typename... T> struct fstring {
 private:
  static constexpr int num_static_named_args =
      detail::count_static_named_args<T...>();

  using checker = detail::format_string_checker<
      char, static_cast<int>(sizeof...(T)), num_static_named_args,
      num_static_named_args != detail::count_named_args<T...>()>;

  using arg_pack = detail::arg_pack<T...>;

 public:
  string_view str;
  using t = fstring;


  template <size_t N>
                inline __attribute__((always_inline)) fstring(const char (&s)[N]) : str(s, N - 1) {
    using namespace detail;
    static_assert(count<(std::is_base_of<view, remove_reference_t<T>>::value &&
                         std::is_reference<T>::value)...>() == 0,
                  "passing views as lvalues is disallowed");
    if (0) parse_format_string<char>(s, checker(s, arg_pack()));

    static_assert(
        0 && sizeof(s) != 0,
        "FMT_ENFORCE_COMPILE_STRING requires format strings to use FMT_STRING");

  }
  template <typename S,
            fmt::enable_if_t<(std::is_convertible<const S&, string_view>::value), int> = 0>
                inline __attribute__((always_inline)) fstring(const S& s) : str(s) {
    auto sv = string_view(str);
    if (0)
      detail::parse_format_string<char>(sv, checker(sv, arg_pack()));

    static_assert(
        0 && sizeof(s) != 0,
        "FMT_ENFORCE_COMPILE_STRING requires format strings to use FMT_STRING");

  }
  template <typename S,
            fmt::enable_if_t<(std::is_base_of<detail::compile_string, S>::value&& std::is_same<typename S::char_type, char>::value), int> = 0>

  inline __attribute__((always_inline)) fstring(const S&) : str(S()) {
    constexpr auto sv = string_view(S());
    constexpr int ignore =
        (parse_format_string(sv, checker(sv, arg_pack())), 0);
    detail::ignore_unused(ignore);
  }
  fstring(runtime_format_string<> fmt) : str(fmt.str) {}


  inline __attribute__((always_inline)) operator const string_view&() const { return str; }
  auto get() const -> string_view { return str; }
};

template <typename... T> using format_string = typename fstring<T...>::t;

