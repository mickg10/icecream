struct VectorImpl {



  template <typename... Args>
  __attribute__((nonnull(1)))
  static inline void new_(T* aDst, Args&&... aArgs) {
    new (KnownNotNull, aDst) T(std::forward<Args>(aArgs)...);
  }


  static inline void destroy(T* aBegin, T* aEnd) {
