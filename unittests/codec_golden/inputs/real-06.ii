}
template <typename T, typename Int, fmt::enable_if_t<(!std::is_integral<T>::value), int> = 0>
inline auto to_nonnegative_int(T value, Int upper) -> Int {
  auto int_value = static_cast<Int>(value);
  if (int_value < 0 || value > static_cast<T>(upper))
    ::fmt::detail::assert_fail("/tanksmall/scratch/ictmp/src3/gecko-dev/obj-cc/dist/include/fmt/chrono.h", 1016, (format_error("invalid value")).what());
