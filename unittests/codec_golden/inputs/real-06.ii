  if (std::isnan(aValue1) || std::isnan(aValue2)) {
    return UnspecifiedNaN<T>();
  }
  return std::min(aValue1, aValue2);
}





template <typename T>
static inline T NaNSafeMax(T aValue1, T aValue2) {
  if (std::isnan(aValue1) || std::isnan(aValue2)) {
    return UnspecifiedNaN<T>();
  }
  return std::max(aValue1, aValue2);
}

