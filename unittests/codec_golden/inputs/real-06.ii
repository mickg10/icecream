__attribute__((weak)) __attribute__((visibility("default"))) void vprint(FILE* f, string_view fmt, format_args args);
__attribute__((weak)) __attribute__((visibility("default"))) void vprintln(FILE* f, string_view fmt, format_args args);
__attribute__((weak)) __attribute__((visibility("default"))) void vprint_buffered(FILE* f, string_view fmt, format_args args);
