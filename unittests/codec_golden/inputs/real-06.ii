    default: ::fmt::detail::assert_fail("/tanksmall/scratch/ictmp/src3/gecko-dev/obj-cc/dist/include/fmt/chrono.h", 857, (format_error("invalid format")).what());
    }
    begin = ptr;
  }
  if (begin != ptr) handler.on_text(begin, ptr);
  return ptr;
}

