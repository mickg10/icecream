    }
  }

  using HasThreadSafeRefCnt =
      std::integral_constant<bool, Atomicity == AtomicRefCount>;


  void ref() { AddRef(); }
  void deref() { Release(); }
  MozRefCountType refCount() const { return mRefCnt; }
  bool hasOneRef() const {
    do { } while (false);
    return mRefCnt == 1;
  }

 private:
  mutable RC<MozRefCountType, Atomicity> mRefCnt;
};
