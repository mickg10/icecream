namespace mozilla {





class PrintfTarget {
 public:

  bool __attribute__((weak)) __attribute__((visibility("default"))) print(const char* format, ...) __attribute__((format(printf, 2, 3)));


  bool __attribute__((weak)) __attribute__((visibility("default"))) vprint(const char* fmt, va_list) __attribute__((format(printf, 2, 0)));




  bool __attribute__((weak)) __attribute__((visibility("default"))) appendIntDec(int32_t);
  bool __attribute__((weak)) __attribute__((visibility("default"))) appendIntDec(uint32_t);
  bool __attribute__((weak)) __attribute__((visibility("default"))) appendIntOct(uint32_t);
  bool __attribute__((weak)) __attribute__((visibility("default"))) appendIntHex(uint32_t);
  bool __attribute__((weak)) __attribute__((visibility("default"))) appendIntDec(int64_t);
  bool __attribute__((weak)) __attribute__((visibility("default"))) appendIntDec(uint64_t);
  bool __attribute__((weak)) __attribute__((visibility("default"))) appendIntOct(uint64_t);
  bool __attribute__((weak)) __attribute__((visibility("default"))) appendIntHex(uint64_t);

  inline size_t emitted() { return mEmitted; }

 protected:
  __attribute__((weak)) __attribute__((visibility("default"))) PrintfTarget();
  virtual ~PrintfTarget() = default;




  virtual bool append(const char* sp, size_t len) = 0;

 private:

  size_t mEmitted;



  bool emit(const char* sp, size_t len) {
    mEmitted += len;
    return append(sp, len);
  }

  bool fill2(const char* src, int srclen, int width, int flags);
  bool fill_n(const char* src, int srclen, int width, int prec, int type,
              int flags);
  bool cvt_l(long num, int width, int prec, int radix, int type, int flags,
             const char* hexp);
  bool cvt_ll(int64_t num, int width, int prec, int radix, int type, int flags,
              const char* hexp);
  bool cvt_f(double d, char c, int width, int prec, int flags);
  bool cvt_s(const char* s, int width, int prec, int flags);
};

namespace detail {

template <typename AllocPolicy = mozilla::MallocAllocPolicy>
struct AllocPolicyBasedFreePolicy {
  void operator()(const void* ptr) {
    AllocPolicy policy;
    policy.free_(const_cast<void*>(ptr));
  }
};

}


template <typename AllocPolicy>
using SmprintfPolicyPointer =
    mozilla::UniquePtr<char, detail::AllocPolicyBasedFreePolicy<AllocPolicy>>;


typedef SmprintfPolicyPointer<mozilla::MallocAllocPolicy> SmprintfPointer;


template <typename AllocPolicy>
class SprintfState final : private mozilla::PrintfTarget,
                                           private AllocPolicy {
 public:
  explicit SprintfState(char* base)
      : mMaxlen(base ? strlen(base) : 0),
        mBase(base),
        mCur(base ? base + mMaxlen : 0) {}

  ~SprintfState() { this->free_(mBase); }

  bool vprint(const char* format, va_list ap_list) __attribute__((format(printf, 2, 0))) {


    return mozilla::PrintfTarget::vprint(format, ap_list) && append("", 1);
  }

  SmprintfPolicyPointer<AllocPolicy> release() {
    SmprintfPolicyPointer<AllocPolicy> result(mBase);
    mBase = nullptr;
    return result;
  }

 protected:
  bool append(const char* sp, size_t len) override {
    ptrdiff_t off;
    char* newbase;
    size_t newlen;

    off = mCur - mBase;
    if (off + len >= mMaxlen) {

      newlen = mMaxlen + ((len > 32) ? len : 32);
      newbase = this->template maybe_pod_malloc<char>(newlen);
      if (!newbase) {

        return false;
      }
      memcpy(newbase, mBase, mMaxlen);
      this->free_(mBase);
      mBase = newbase;
      mMaxlen = newlen;
      mCur = mBase + off;
    }


    memcpy(mCur, sp, len);
    mCur += len;
    do { } while (false);
    return true;
  }

 private:
  size_t mMaxlen;
  char* mBase;
  char* mCur;
};






template <typename AllocPolicy = mozilla::MallocAllocPolicy>
__attribute__((format(printf, 1, 2)))
SmprintfPolicyPointer<AllocPolicy> Smprintf(const char* fmt, ...) {
  SprintfState<AllocPolicy> ss(nullptr);
  va_list ap;
  __builtin_va_start(ap, fmt);
  bool r = ss.vprint(fmt, ap);
  __builtin_va_end(ap);
  if (!r) {
    return nullptr;
  }
  return ss.release();
}
