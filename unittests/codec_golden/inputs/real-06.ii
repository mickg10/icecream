SmprintfPolicyPointer<AllocPolicy> SmprintfAppend(
    SmprintfPolicyPointer<AllocPolicy>&& last, const char* fmt, ...) {
  SprintfState<AllocPolicy> ss(last.release());
  va_list ap;
  __builtin_va_start(ap, fmt);
  bool r = ss.vprint(fmt, ap);
  __builtin_va_end(ap);
  if (!r) {
    return nullptr;
