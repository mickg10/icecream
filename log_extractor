#!/usr/bin/env python3

import argparse
import csv
import datetime as _dt
import gzip
import json
import os
import re
import sys
import tarfile
from collections import Counter
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, TextIO, Tuple


def _open_text(path: str) -> TextIO:
    if path == "-":
        return sys.stdin
    if path.endswith(".gz"):
        return gzip.open(path, "rt", encoding="utf-8", errors="replace")
    return open(path, "rt", encoding="utf-8", errors="replace")


def _ts_iso_utc(ts: Optional[int]) -> str:
    if ts is None:
        return ""
    try:
        return _dt.datetime.fromtimestamp(int(ts), tz=_dt.timezone.utc).isoformat()
    except Exception:
        return ""


def _ts_iso_utc_ms(epoch_msec: Optional[int]) -> str:
    if epoch_msec is None:
        return ""
    try:
        sec = int(epoch_msec) / 1000.0
        return _dt.datetime.fromtimestamp(sec, tz=_dt.timezone.utc).isoformat()
    except Exception:
        return ""


def _safe_get(d: Any, *path: str, default: Any = None) -> Any:
    cur = d
    for key in path:
        if not isinstance(cur, dict):
            return default
        cur = cur.get(key)
    return cur if cur is not None else default


def _write_csv(path: Path, fieldnames: List[str], rows: Iterable[Dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=fieldnames, extrasaction="ignore")
        w.writeheader()
        for row in rows:
            w.writerow(row)


def _write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


ICECC_EXCEPTION_RE = re.compile(
    r"^ICECC\[(?P<pid>\d+)\]\s+"
    r"(?P<dt>\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}):\s+"
    r"got exception Error\s+(?P<code>\d+)\s+-\s+(?P<msg>.*)$"
)


@dataclass
class IceccException:
    dt: str
    pid: int
    code: int
    msg: str
    host: str
    raw: str


def _parse_icecc_exception(line: str) -> Optional[IceccException]:
    m = ICECC_EXCEPTION_RE.match(line.strip())
    if not m:
        return None
    msg = m.group("msg").strip()
    host = ""
    host_m = re.search(r"\(([^()]+)\)\s*$", msg)
    if host_m:
        host = host_m.group(1).strip()
    return IceccException(
        dt=m.group("dt"),
        pid=int(m.group("pid")),
        code=int(m.group("code")),
        msg=msg,
        host=host,
        raw=line.rstrip("\n"),
    )


def _guess_prefix(logfile: str) -> str:
    name = Path(logfile).name
    for suffix in (".jsonl.gz", ".json.gz", ".jsonl", ".json", ".log.gz", ".log", ".txt.gz", ".txt", ".gz"):
        if name.endswith(suffix):
            name = name[: -len(suffix)]
            break
    return name or "log"


def _tar_outputs(outdir: Path, tar_path: Path) -> None:
    with tarfile.open(tar_path, "w:gz") as tf:
        for child in sorted(outdir.iterdir()):
            tf.add(child, arcname=child.name)


def main(argv: List[str]) -> int:
    ap = argparse.ArgumentParser(
        prog="log_extractor",
        description="Extract icecream diagnostics from daemon JSONL state/job timing logs and ICECC exception logs.",
    )
    ap.add_argument("logfile", help="Input logfile path. Use '-' to read from stdin.")
    ap.add_argument(
        "--outdir",
        default="",
        help="Output directory (default: ./log_extract_<prefix>_<UTC timestamp>)",
    )
    ap.add_argument("--prefix", default="", help="Output file prefix (default: derived from logfile name)")
    ap.add_argument("--tar", action="store_true", help="Also write a .tar.gz bundle of outputs")
    args = ap.parse_args(argv)

    prefix = args.prefix or _guess_prefix(args.logfile)
    stamp = _dt.datetime.now(tz=_dt.timezone.utc).strftime("%Y%m%d_%H%M%S")
    outdir = Path(args.outdir) if args.outdir else Path(f"log_extract_{prefix}_{stamp}")
    outdir.mkdir(parents=True, exist_ok=True)

    total_lines = 0
    json_lines = 0
    bad_json_lines = 0
    state_rows: List[Dict[str, Any]] = []
    worst_rows: List[Dict[str, Any]] = []
    job_rows: List[Dict[str, Any]] = []
    exceptions: List[IceccException] = []

    statuses_seen: Counter[str] = Counter()

    with _open_text(args.logfile) as f:
        for raw in f:
            total_lines += 1
            line = raw.strip()
            if not line:
                continue

            exc = _parse_icecc_exception(raw)
            if exc:
                exceptions.append(exc)
                continue

            if not line.startswith("{"):
                continue

            json_lines += 1
            try:
                obj = json.loads(line)
            except Exception:
                bad_json_lines += 1
                continue
            if not isinstance(obj, dict):
                continue

            typ = obj.get("type")

            if typ == "iceccd_job_timing":
                ts = _safe_get(obj, "ts", default=None)
                mono_msec = _safe_get(obj, "mono_msec", default=None)
                submit_ts_raw = _safe_get(obj, "submit_ts", default=None)
                try:
                    submit_ts = int(submit_ts_raw) if submit_ts_raw is not None else None
                except Exception:
                    submit_ts = None

                enqueue_msec = _safe_get(obj, "enqueue_msec", default=None)
                start_msec = _safe_get(obj, "start_msec", default=None)
                finish_msec = _safe_get(obj, "finish_msec", default=None)

                def _epoch_ms(offset_msec: Any) -> Optional[int]:
                    if submit_ts is None or offset_msec is None:
                        return None
                    try:
                        return submit_ts * 1000 + int(offset_msec)
                    except Exception:
                        return None

                enqueue_ts_ms = _epoch_ms(enqueue_msec)
                start_ts_ms = _epoch_ms(start_msec)
                finish_ts_ms = _epoch_ms(finish_msec)

                job_rows.append(
                    {
                        "ts": ts,
                        "ts_iso_utc": _ts_iso_utc(ts),
                        "mono_msec": mono_msec,
                        "node": _safe_get(obj, "node", default=""),
                        "client_id": _safe_get(obj, "client_id", default=None),
                        "scheduler_job_id": _safe_get(obj, "scheduler_job_id", default=None),
                        "compile_job_id": _safe_get(obj, "compile_job_id", default=None),
                        "exitcode": _safe_get(obj, "exitcode", default=None),
                        "end_code": _safe_get(obj, "end_code", default=None),
                        "final_status": _safe_get(obj, "final_status", default=""),
                        "final_why": _safe_get(obj, "final_why", default=""),
                        "mode": _safe_get(obj, "mode", default=""),
                        "timing_source": _safe_get(obj, "timing_source", default=""),
                        "submit_ts": submit_ts,
                        "submit_iso_utc": _ts_iso_utc(submit_ts),
                        "enqueue_msec": enqueue_msec,
                        "start_msec": start_msec,
                        "finish_msec": finish_msec,
                        "waitforcs_msec": _safe_get(obj, "waitforcs_msec", default=None),
                        "local_queue_msec": _safe_get(obj, "local_queue_msec", default=None),
                        "exec_msec": _safe_get(obj, "exec_msec", default=None),
                        "enqueue_ts_ms": enqueue_ts_ms,
                        "enqueue_iso_utc": _ts_iso_utc_ms(enqueue_ts_ms),
                        "start_ts_ms": start_ts_ms,
                        "start_iso_utc": _ts_iso_utc_ms(start_ts_ms),
                        "finish_ts_ms": finish_ts_ms,
                        "finish_iso_utc": _ts_iso_utc_ms(finish_ts_ms),
                        "cmdline": _safe_get(obj, "cmdline", default=""),
                    }
                )
                continue

            if typ != "iceccd_state":
                continue

            ts = _safe_get(obj, "ts", default=None)
            mono_msec = _safe_get(obj, "mono_msec", default=None)
            scheduler_connected = bool(_safe_get(obj, "scheduler", "connected", default=False))
            scheduler_name = _safe_get(obj, "scheduler", "name", default="")
            scheduler_protocol = _safe_get(obj, "scheduler", "protocol", default=None)
            scheduler_last_talk_age_s = _safe_get(obj, "scheduler", "last_talk_age_s", default=None)
            scheduler_next_retry_in_s = _safe_get(obj, "scheduler", "next_retry_in_s", default=None)

            row: Dict[str, Any] = {
                "ts": ts,
                "ts_iso_utc": _ts_iso_utc(ts),
                "mono_msec": mono_msec,
                "pid": _safe_get(obj, "pid", default=None),
                "node": _safe_get(obj, "node", default=""),
                "remote_name": _safe_get(obj, "remote_name", default=""),
                "netname": _safe_get(obj, "netname", default=""),
                "noremote": _safe_get(obj, "noremote", default=None),
                "scheduler_connected": scheduler_connected,
                "scheduler_name": scheduler_name,
                "scheduler_protocol": scheduler_protocol,
                "scheduler_last_talk_age_s": scheduler_last_talk_age_s,
                "scheduler_next_retry_in_s": scheduler_next_retry_in_s,
                "slots_max_kids": _safe_get(obj, "slots", "max_kids", default=None),
                "slots_max_preprocess_kids": _safe_get(obj, "slots", "max_preprocess_kids", default=None),
                "slots_current_kids": _safe_get(obj, "slots", "current_kids", default=None),
                "slots_active_processes": _safe_get(obj, "slots", "active_processes", default=None),
                "slots_active_preprocesses": _safe_get(obj, "slots", "active_preprocesses", default=None),
                "slots_used": _safe_get(obj, "slots", "used", default=None),
                "fds_open": _safe_get(obj, "fds", "open", default=None),
                "fds_headroom": _safe_get(obj, "fds", "headroom", default=None),
                "fds_util_pct": _safe_get(obj, "fds", "util_pct", default=None),
                "stats_current_load": _safe_get(obj, "stats", "current_load", default=None),
                "stats_loadAvg1": _safe_get(obj, "stats", "loadAvg1", default=None),
                "stats_loadAvg5": _safe_get(obj, "stats", "loadAvg5", default=None),
                "stats_loadAvg10": _safe_get(obj, "stats", "loadAvg10", default=None),
                "stats_cpu_idle": _safe_get(obj, "stats", "cpu_idle", default=None),
                "stats_cpu_nice": _safe_get(obj, "stats", "cpu_nice", default=None),
                "stats_memory_fillgrade": _safe_get(obj, "stats", "memory_fillgrade", default=None),
                "stats_freeMemMB": _safe_get(obj, "stats", "freeMemMB", default=None),
                "cache_size": _safe_get(obj, "cache", "cache_size", default=None),
                "cache_size_limit": _safe_get(obj, "cache", "cache_size_limit", default=None),
                "cache_native_envs": _safe_get(obj, "cache", "native_envs", default=None),
                "cache_received_envs": _safe_get(obj, "cache", "received_envs", default=None),
                "clients_total": _safe_get(obj, "clients", "total", default=None),
                "local_jobs_queued": _safe_get(obj, "clients", "local_jobs", "queued", default=None),
                "local_jobs_running": _safe_get(obj, "clients", "local_jobs", "running", default=None),
                "local_jobs_total": _safe_get(obj, "clients", "local_jobs", "total", default=None),
                "waitforcs_use_cs_avg_msec": _safe_get(obj, "waitforcs_latency_msec", "use_cs", "avg_msec", default=None),
                "waitforcs_use_cs_max_msec": _safe_get(obj, "waitforcs_latency_msec", "use_cs", "max_msec", default=None),
                "waitforcs_no_cs_avg_msec": _safe_get(obj, "waitforcs_latency_msec", "no_cs", "avg_msec", default=None),
                "waitforcs_no_cs_max_msec": _safe_get(obj, "waitforcs_latency_msec", "no_cs", "max_msec", default=None),
                "waitforcs_combined_avg_msec": _safe_get(obj, "waitforcs_latency_msec", "combined", "avg_msec", default=None),
                "waitforcs_combined_max_msec": _safe_get(obj, "waitforcs_latency_msec", "combined", "max_msec", default=None),
            }

            by_status = _safe_get(obj, "clients", "by_status", default={})
            if isinstance(by_status, dict):
                for st, st_obj in by_status.items():
                    if not isinstance(st, str) or not isinstance(st_obj, dict):
                        continue
                    statuses_seen[st] += 1
                    row[f"st_{st}"] = st_obj.get("count", 0)

            state_rows.append(row)

            worst = _safe_get(obj, "clients", "worst", default=_safe_get(obj, "worst", default=[]))
            if isinstance(worst, list):
                for w in worst:
                    if not isinstance(w, dict):
                        continue
                    usecs = w.get("usecs") if isinstance(w.get("usecs"), dict) else {}
                    worst_rows.append(
                        {
                            "ts": ts,
                            "ts_iso_utc": _ts_iso_utc(ts),
                            "client_id": w.get("client_id", ""),
                            "status": w.get("status", ""),
                            "age_msec": w.get("age_msec", ""),
                            "local_job": w.get("local_job", ""),
                            "local_job_kind": w.get("local_job_kind", ""),
                            "local_reason": w.get("local_reason", ""),
                            "cmdline": w.get("cmdline", ""),
                            "why": w.get("why", ""),
                            "scheduler_job_id": w.get("scheduler_job_id", ""),
                            "usecs_hostname": usecs.get("hostname", ""),
                            "usecs_port": usecs.get("port", ""),
                            "usecs_got_env": usecs.get("got_env", ""),
                            "usecs_host_platform": usecs.get("host_platform", ""),
                            "outfile": w.get("outfile", ""),
                            "env_bytes_received": w.get("env_bytes_received", ""),
                            "pending_create_env": w.get("pending_create_env", ""),
                            "channel": w.get("channel", ""),
                        }
                    )

    # Build CSV schema after parsing for forward/backward compatibility.
    state_status_cols = sorted({k for row in state_rows for k in row.keys() if k.startswith("st_")})
    state_fieldnames = [
        "ts",
        "ts_iso_utc",
        "mono_msec",
        "pid",
        "node",
        "remote_name",
        "netname",
        "noremote",
        "scheduler_connected",
        "scheduler_name",
        "scheduler_protocol",
        "scheduler_last_talk_age_s",
        "scheduler_next_retry_in_s",
        "slots_max_kids",
        "slots_max_preprocess_kids",
        "slots_current_kids",
        "slots_active_processes",
        "slots_active_preprocesses",
        "slots_used",
        "fds_open",
        "fds_headroom",
        "fds_util_pct",
        "stats_current_load",
        "stats_loadAvg1",
        "stats_loadAvg5",
        "stats_loadAvg10",
        "stats_cpu_idle",
        "stats_cpu_nice",
        "stats_memory_fillgrade",
        "stats_freeMemMB",
        "cache_size",
        "cache_size_limit",
        "cache_native_envs",
        "cache_received_envs",
        "clients_total",
        "local_jobs_queued",
        "local_jobs_running",
        "local_jobs_total",
        "waitforcs_use_cs_avg_msec",
        "waitforcs_use_cs_max_msec",
        "waitforcs_no_cs_avg_msec",
        "waitforcs_no_cs_max_msec",
        "waitforcs_combined_avg_msec",
        "waitforcs_combined_max_msec",
    ] + state_status_cols

    worst_fieldnames = [
        "ts",
        "ts_iso_utc",
        "client_id",
        "status",
        "age_msec",
        "local_job",
        "local_job_kind",
        "local_reason",
        "cmdline",
        "why",
        "scheduler_job_id",
        "usecs_hostname",
        "usecs_port",
        "usecs_got_env",
        "usecs_host_platform",
        "outfile",
        "env_bytes_received",
        "pending_create_env",
        "channel",
    ]

    job_fieldnames = [
        "ts",
        "ts_iso_utc",
        "mono_msec",
        "node",
        "client_id",
        "scheduler_job_id",
        "compile_job_id",
        "exitcode",
        "end_code",
        "final_status",
        "final_why",
        "mode",
        "timing_source",
        "submit_ts",
        "submit_iso_utc",
        "enqueue_msec",
        "start_msec",
        "finish_msec",
        "waitforcs_msec",
        "local_queue_msec",
        "exec_msec",
        "enqueue_ts_ms",
        "enqueue_iso_utc",
        "start_ts_ms",
        "start_iso_utc",
        "finish_ts_ms",
        "finish_iso_utc",
        "cmdline",
    ]

    exc_rows = [
        {
            "dt": e.dt,
            "pid": e.pid,
            "code": e.code,
            "host": e.host,
            "msg": e.msg,
            "raw": e.raw,
        }
        for e in exceptions
    ]
    exc_fieldnames = ["dt", "pid", "code", "host", "msg", "raw"]

    # Write outputs.
    produced: List[Path] = []

    if state_rows:
        p = outdir / f"{prefix}.state_timeline.csv"
        _write_csv(p, state_fieldnames, state_rows)
        produced.append(p)

        p = outdir / f"{prefix}.worst_clients.csv"
        _write_csv(p, worst_fieldnames, worst_rows)
        produced.append(p)

    if job_rows:
        p = outdir / f"{prefix}.job_timing.csv"
        _write_csv(p, job_fieldnames, job_rows)
        produced.append(p)

    if exc_rows:
        p = outdir / f"{prefix}.icecc_exceptions.csv"
        _write_csv(p, exc_fieldnames, exc_rows)
        produced.append(p)

    # Summary.
    summary_lines: List[str] = []
    summary_lines.append(f"input: {args.logfile}")
    summary_lines.append(f"outdir: {outdir}")
    summary_lines.append("")
    summary_lines.append(f"lines_total: {total_lines}")
    summary_lines.append(f"json_lines: {json_lines}")
    summary_lines.append(f"bad_json_lines: {bad_json_lines}")
    summary_lines.append(f"iceccd_state_entries: {len(state_rows)}")
    summary_lines.append(f"iceccd_job_timing_entries: {len(job_rows)}")
    summary_lines.append(f"icecc_exception_lines: {len(exceptions)}")

    if state_rows:
        ts_vals = [r.get("ts") for r in state_rows if isinstance(r.get("ts"), int)]
        if ts_vals:
            summary_lines.append("")
            summary_lines.append(f"ts_first: {min(ts_vals)} ({_ts_iso_utc(min(ts_vals))})")
            summary_lines.append(f"ts_last:  {max(ts_vals)} ({_ts_iso_utc(max(ts_vals))})")
            if len(ts_vals) >= 2:
                ts_sorted = sorted(ts_vals)
                deltas = [ts_sorted[i] - ts_sorted[i - 1] for i in range(1, len(ts_sorted)) if ts_sorted[i] >= ts_sorted[i - 1]]
                if deltas:
                    deltas_sorted = sorted(deltas)
                    summary_lines.append(f"state_interval_s_min: {deltas_sorted[0]}")
                    summary_lines.append(f"state_interval_s_p50: {deltas_sorted[len(deltas_sorted)//2]}")
                    summary_lines.append(f"state_interval_s_max: {deltas_sorted[-1]}")

        if state_status_cols:
            summary_lines.append("")
            summary_lines.append("status_columns:")
            for c in state_status_cols:
                summary_lines.append(f"  - {c}")

    if exceptions:
        by_code = Counter(e.code for e in exceptions)
        by_host = Counter(e.host for e in exceptions if e.host)
        summary_lines.append("")
        summary_lines.append("exceptions_by_code:")
        for code, count in by_code.most_common():
            summary_lines.append(f"  - {code}: {count}")
        if by_host:
            summary_lines.append("")
            summary_lines.append("exceptions_by_host:")
            for host, count in by_host.most_common(20):
                summary_lines.append(f"  - {host}: {count}")

    if job_rows:
        def _to_int(value: Any) -> Optional[int]:
            if value is None or value == "":
                return None
            try:
                return int(value)
            except Exception:
                return None

        def _pct(values: List[int], p: float) -> Optional[int]:
            if not values:
                return None
            values = sorted(values)
            idx = int(round((len(values) - 1) * p))
            if idx < 0:
                idx = 0
            if idx >= len(values):
                idx = len(values) - 1
            return values[idx]

        # Exit codes: since the daemon now records the compiler's real status
        # in "exitcode" and its own teardown code separately in "end_code",
        # the success rate below finally reflects compilations rather than
        # transport teardown (118/119).  Older logs without end_code are
        # still summarised, with a note.
        exitcodes = [_to_int(r.get("exitcode")) for r in job_rows]
        exitcodes = [v for v in exitcodes if v is not None]
        ok = sum(1 for v in exitcodes if v == 0)
        has_end_code = any(r.get("end_code") not in (None, "") for r in job_rows)
        modes = Counter((r.get("mode") or "") for r in job_rows)
        sources = Counter((r.get("timing_source") or "") for r in job_rows)

        queue_ms = [_to_int(r.get("local_queue_msec")) for r in job_rows]
        queue_ms = [v for v in queue_ms if v is not None]
        exec_ms = [_to_int(r.get("exec_msec")) for r in job_rows]
        exec_ms = [v for v in exec_ms if v is not None]
        waitforcs_ms = [_to_int(r.get("waitforcs_msec")) for r in job_rows]
        waitforcs_ms = [v for v in waitforcs_ms if v is not None]

        summary_lines.append("")
        summary_lines.append("job_timing:")
        if exitcodes:
            summary_lines.append(f"  - success: {ok}/{len(exitcodes)} ({(100.0 * ok / len(exitcodes)):.1f}%)")
            if not has_end_code:
                summary_lines.append("  - note: log predates the exitcode/end_code split;"
                                     " success may reflect daemon teardown codes, not compiler results")
        if modes:
            summary_lines.append("  - modes:")
            for k, v in modes.most_common():
                summary_lines.append(f"      - {k or '<empty>'}: {v}")
        if sources:
            summary_lines.append("  - timing_source:")
            for k, v in sources.most_common():
                summary_lines.append(f"      - {k or '<empty>'}: {v}")

        def _emit_pct(label: str, values: List[int]) -> None:
            if not values:
                return
            summary_lines.append(
                f"  - {label}: p50={_pct(values, 0.50)} p90={_pct(values, 0.90)} p99={_pct(values, 0.99)} max={max(values)}"
            )

        _emit_pct("local_queue_msec", queue_ms)
        _emit_pct("exec_msec", exec_ms)
        _emit_pct("waitforcs_msec", waitforcs_ms)

    p = outdir / f"{prefix}.summary.txt"
    _write_text(p, "\n".join(summary_lines) + "\n")
    produced.append(p)

    tar_path = outdir / f"{prefix}.bundle.tar.gz"
    if args.tar:
        _tar_outputs(outdir, tar_path)
        produced.append(tar_path)

    # Print a minimal report for copy/paste workflows.
    print("OK")
    for p in produced:
        print(str(p))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
